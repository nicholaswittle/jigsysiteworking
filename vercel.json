{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run stage",
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://jigsys-ordering-demo.nicholaswittle.chatgpt.site/:path*",
      "permanent": false
    }
  ]
}
